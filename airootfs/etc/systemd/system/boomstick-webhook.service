[Unit]
Description=Report addresses and WireGuard status to a webhook
# Only present when the config partition has a WEBHOOK_URL
# (see boomstick-config.service).
ConditionPathExists=/etc/boomstick/webhook.env
Wants=network-online.target
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
EnvironmentFile=/etc/boomstick/webhook.env
ExecStart=/usr/local/bin/boomstick-webhook

[Install]
WantedBy=multi-user.target
